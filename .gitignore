# Données d'étudiants : JAMAIS dans le dépôt ni dans un partage entre collègues
scans/
sorties/
out/
*.pdf
!templates/*.pdf
crops/
# sujets d'examen (PDF, zones, corrigés) : confidentiels jusqu'à l'examen
sujets/
# Midterm de novembre 2026 : gabarits, corrigés et barème contiennent le sujet -> hors dépôt jusqu'à l'examen
templates/midterm_2026_*
keys/midterm_2026*
# vérités terrain transcrites depuis des copies réelles (réponses d'étudiants, anonymisées mais personnelles)
data/truth/*
# modèles affinés localement sur des copies réelles ; le modèle partagé est thessalia/data/digits_affine.npz
data/models/
# listes d'étudiants (noms, numéros) : jamais dans le dépôt
data/listes/
# décisions de correction (réponses d'étudiants)
data/correction.sqlite
data/correction_essai.sqlite
!data/truth/README.md

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
sim/
# transcription en ligne : réglages, clé et dépenses (jamais dans le dépôt)
data/lecteur.json
data/lecteur.cle
data/lecteur_depenses.json
# archive du générateur de sujets (contient sujets et corrigés) : hors dépôt
esme_python_exam_generator.zip
# examens de l application (source, PDF produits, scans et résultats des élèves) : hors dépôt
examens/
# sujets et corrigés d'examen (anciens compris) : sur le PC de l'enseignant seulement, dépôt public
templates/
keys/
docs/exemple_overlay_q4.jpg
